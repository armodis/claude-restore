# Template only. Do not put a real key in this file or anywhere in this repo.
# Run `claude-provider key` instead: it prompts for your key without echoing it
# and writes ~/.config/claude-provider/bedrock.env with mode 600.
CLAUDE_CODE_USE_BEDROCK=1
AWS_REGION=us-east-1
AWS_BEARER_TOKEN_BEDROCK=<your-own-bedrock-api-key>

# Optional: pin the model Claude Code uses on Bedrock.
# ANTHROPIC_MODEL=us.anthropic.claude-opus-5-5
